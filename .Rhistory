## Anonymise data
setwd("~/Documents/GitHub/hyenaindirecteffects")
data <- read.csv("data/lifehistory_clans.csv", stringsAsFactors = FALSE)
ped  <- read.csv("data/hyenapedigree.csv", stringsAsFactors = FALSE,row.names = 1)
social <- as.matrix(read.csv("data/SRI_temporal_5.csv", row.names = 1))
load("data/SRItmp_sim.jac.R")
hro <- as.matrix(read.csv("data/hro_VI_5.csv", row.names = 1))
rownames(social)
colnames(social)
colnames(social)<-rownames(social)
colnames(SRItmp_sim.jac)
rownames(SRItmp_sim.jac)
rownames(hro)
colnames(hro)
colnames(hro)<-rownames(hro)
IDs<-unique(data$ID,ped$ID,ped$sire,ped$dam,rownames(social),colnames(social),
rownames(SRItmp_sim.jac),colnames(SRItmp_sim.jac),
rownames(hro),colnames(hro))
IDs<-unique(c(data$ID,ped$ID,ped$sire,ped$dam,rownames(social),colnames(social),
rownames(SRItmp_sim.jac),colnames(SRItmp_sim.jac),
rownames(hro),colnames(hro)))
IDs
paste0("Cro_",seq(1,nrow(IDs)))
seq(1,nrow(IDs))
seq(1:nrow(IDs))
ID_deID <- data.frame(
ID = IDs,
deID = paste0("Cro_", seq_along(IDs)),
stringsAsFactors = FALSE
)
data <- read.csv("data/lifehistory_clans.csv", stringsAsFactors = FALSE)
ped  <- read.csv("data/hyenapedigree.csv", stringsAsFactors = FALSE,row.names = 1)
social <- as.matrix(read.csv("data/SRI_temporal_5.csv", row.names = 1))
load("data/SRItmp_sim.jac.R")
hro <- as.matrix(read.csv("data/hro_VI_5.csv", row.names = 1))
colnames(social)<-rownames(social)
colnames(hro)<-rownames(hro)
IDs<-unique(c(data$ID,ped$ID,ped$sire,ped$dam,rownames(social),colnames(social),
rownames(SRItmp_sim.jac),colnames(SRItmp_sim.jac),
rownames(hro),colnames(hro)))
paste0("Cro_",seq(1:nrow(IDs)))
ID_deID
# Replace IDs in the life-history dataset
data$ID <- ID_deID$deID[match(data$ID, ID_deID$ID)]
data$ID
# Replace IDs in the pedigree dataset
ped$ID   <- ID_deID$deID[match(ped$ID, ID_deID$ID)]
ped$sire <- ID_deID$deID[match(ped$sire, ID_deID$ID)]
ped$dam  <- ID_deID$deID[match(ped$dam, ID_deID$ID)]
ped
# Replace IDs in the social network matrix
rownames(social) <- ID_deID$deID[match(rownames(social), ID_deID$ID)]
colnames(social) <- ID_deID$deID[match(colnames(social), ID_deID$ID)]
# Replace IDs in the simulated social network matrix
rownames(SRItmp_sim.jac) <-
ID_deID$deID[match(rownames(SRItmp_sim.jac), ID_deID$ID)]
colnames(SRItmp_sim.jac) <-
ID_deID$deID[match(colnames(SRItmp_sim.jac), ID_deID$ID)]
# Replace IDs in the HRO matrix
rownames(hro) <- ID_deID$deID[match(rownames(hro), ID_deID$ID)]
colnames(hro) <- ID_deID$deID[match(colnames(hro), ID_deID$ID)]
# Save the anonymised datasets
write.csv(data, "data/lifehistory_clans_anon.csv", row.names = FALSE)
write.csv(ped, "data/hyenapedigree_anon.csv", row.names = TRUE)
write.csv(social, "data/SRI_temporal_5_anon.csv", row.names = TRUE)
save(SRItmp_sim.jac, "data/SRItmp_sim_jac_anon.R", row.names = TRUE)
save(SRItmp_sim.jac, "data/SRItmp_sim_jac_anon.R")
SRItmp_sim.jac
save(SRItmp_sim.jac,"data/SRItmp_sim_jac_anon.R")
save(SRItmp_sim.jac,file="data/SRItmp_sim_jac_anon.R")
# Save the mapping separately for controlled reference
write.csv(ID_deID, "data/ID_deID.csv", row.names = FALSE)
View(data)
ID_deID$deID[match(data$mother, ID_deID$ID)]
data[[1]]
View(data)
View(ID_deID)
data$mother <- ID_deID$deID[match(data$mother, ID_deID$ID)]
data[[1]]
View(data)
# Save the anonymised datasets
write.csv(data, "data/lifehistory_clans_anon.csv", row.names = FALSE)
write.csv(ped, "data/hyenapedigree_anon.csv", row.names = TRUE)
write.csv(social, "data/SRI_temporal_5_anon.csv", row.names = TRUE)
save(SRItmp_sim.jac,file="data/SRItmp_sim_jac_anon.R")
write.csv(hro, "data/hro_VI_5_anon.csv", row.names = TRUE)
# Save the mapping separately for controlled reference
write.csv(ID_deID, "data/ID_deID.csv", row.names = FALSE)
